' ============================================================
' BNP PARIBAS GANTT CHART - FULLY DYNAMIC (NO HARDCODING)
' ============================================================
' HOW TO USE:
'   1. Open PowerPoint (start with a blank presentation)
'   2. Press Alt + F11 to open the VBA Editor
'   3. Click Insert > Module
'   4. Paste this entire code into the module
'   5. Press F5 or click Run > Run Sub/UserForm
'   6. A step-by-step wizard will guide you through all inputs
'
' AFTER THE SLIDE IS BUILT:
'   - Click any shape to move or resize it freely
'   - Double-click any shape to edit its text
'   - Use View > Selection Pane to find shapes by name
'   - Right-click > Size and Position for precise values
' ============================================================

Option Explicit

' â”€â”€ Global data (filled by wizard, used by builder) â”€â”€â”€â”€â”€â”€â”€â”€
Dim gTitle       As String
Dim gSubtitle    As String
Dim gYear        As String
Dim gDept        As String
Dim gTodayMonth  As Single   ' fractional month, e.g. 2.5 = mid-March

Dim gTaskCount   As Integer
Dim gTaskNames() As String
Dim gTaskStart() As Integer  ' 0-based month index
Dim gTaskEnd()   As Integer  ' exclusive end (so 3 months = end - start = 3)
Dim gTaskType()  As Integer  ' 0 = Complete, 1 = In Progress, 2 = Planned

Dim gMsCount     As Integer
Dim gMsLabels()  As String
Dim gMsMonths()  As Integer  ' 0-based month index
Dim gMsRows()    As Integer  ' 0-based task row index


' ============================================================
' ENTRY POINT
' ============================================================
Sub CreateBNPGanttChart()

    ' Run the 3-step input wizard
    If Not CollectGeneralInfo() Then
        MsgBox "Cancelled. No slides were created.", vbInformation
        Exit Sub
    End If

    If Not CollectTasks() Then
        MsgBox "Cancelled. No slides were created.", vbInformation
        Exit Sub
    End If

    If Not CollectMilestones() Then
        MsgBox "Cancelled. No slides were created.", vbInformation
        Exit Sub
    End If

    ' Clear existing slides and build fresh
    Dim prs As Presentation
    Set prs = ActivePresentation

    Do While prs.Slides.Count > 0
        prs.Slides(1).Delete
    Loop

    prs.PageSetup.SlideWidth = 720
    prs.PageSetup.SlideHeight = 405

    Call BuildTitleSlide(prs)
    Call BuildGanttSlide(prs)

    prs.Slides(2).Select

    MsgBox "Your Gantt chart is ready!" & Chr(10) & Chr(10) & _
           "EDITING TIPS:" & Chr(10) & _
           "  - Click any shape to move or resize it" & Chr(10) & _
           "  - Double-click any shape to edit text" & Chr(10) & _
           "  - View > Selection Pane to find shapes by name" & Chr(10) & _
           "  - Right-click > Size and Position for exact values", _
           vbInformation, "BNP Paribas Gantt Chart"

End Sub


' ============================================================
' STEP 1 OF 3 - GENERAL INFORMATION
' ============================================================
Function CollectGeneralInfo() As Boolean

    CollectGeneralInfo = False

    ' Project title
    gTitle = InputBox( _
        "STEP 1 OF 3 - GENERAL INFORMATION" & Chr(10) & String(40, "-") & Chr(10) & Chr(10) & _
        "Enter the slide title:" & Chr(10) & _
        "(This appears as the large heading on both slides)", _
        "Gantt Chart Wizard - Step 1/3", "Project Gantt Chart")
    If gTitle = "" Then Exit Function

    ' Subtitle
    gSubtitle = InputBox( _
        "STEP 1 OF 3 - GENERAL INFORMATION" & Chr(10) & String(40, "-") & Chr(10) & Chr(10) & _
        "Enter the subtitle:" & Chr(10) & _
        "(e.g. project description or roadmap label)", _
        "Gantt Chart Wizard - Step 1/3", Year(Now) & " Project Roadmap  |  Programme Delivery Office")
    If gSubtitle = "" Then Exit Function

    ' Year
    gYear = InputBox( _
        "STEP 1 OF 3 - GENERAL INFORMATION" & Chr(10) & String(40, "-") & Chr(10) & Chr(10) & _
        "Enter the project year:" & Chr(10) & _
        "(Used in the header, footer, and title slide)", _
        "Gantt Chart Wizard - Step 1/3", CStr(Year(Now)))
    If gYear = "" Then Exit Function

    ' Department
    gDept = InputBox( _
        "STEP 1 OF 3 - GENERAL INFORMATION" & Chr(10) & String(40, "-") & Chr(10) & Chr(10) & _
        "Enter your department or team name:" & Chr(10) & _
        "(Appears in the footer and subtitle)", _
        "Gantt Chart Wizard - Step 1/3", "Programme Delivery Office")
    If gDept = "" Then Exit Function

    ' Today marker
    Dim todayStr As String
    Do
        todayStr = InputBox( _
            "STEP 1 OF 3 - GENERAL INFORMATION" & Chr(10) & String(40, "-") & Chr(10) & Chr(10) & _
            "Enter today's month number (1 to 12):" & Chr(10) & _
            "  1 = January, 2 = February ... 12 = December" & Chr(10) & Chr(10) & _
            "This positions the red TODAY marker on the chart.", _
            "Gantt Chart Wizard - Step 1/3", CStr(Month(Now)))
        If todayStr = "" Then Exit Function
        If IsNumeric(todayStr) Then
            If CInt(todayStr) >= 1 And CInt(todayStr) <= 12 Then Exit Do
        End If
        MsgBox "Please enter a whole number between 1 and 12.", vbExclamation, "Invalid Input"
    Loop

    ' Store as fractional (mid-month position)
    gTodayMonth = CDbl(todayStr) - 0.5

    CollectGeneralInfo = True

End Function


' ============================================================
' STEP 2 OF 3 - TASKS
' ============================================================
Function CollectTasks() As Boolean

    CollectTasks = False

    ' How many tasks?
    Dim countStr As String
    Do
        countStr = InputBox( _
            "STEP 2 OF 3 - TASKS" & Chr(10) & String(40, "-") & Chr(10) & Chr(10) & _
            "How many tasks do you want on the Gantt chart?" & Chr(10) & _
            "(Enter a number between 1 and 12)", _
            "Gantt Chart Wizard - Step 2/3", "9")
        If countStr = "" Then Exit Function
        If IsNumeric(countStr) Then
            If CInt(countStr) >= 1 And CInt(countStr) <= 12 Then Exit Do
        End If
        MsgBox "Please enter a number between 1 and 12.", vbExclamation, "Invalid Input"
    Loop

    gTaskCount = CInt(countStr)
    ReDim gTaskNames(gTaskCount - 1)
    ReDim gTaskStart(gTaskCount - 1)
    ReDim gTaskEnd(gTaskCount - 1)
    ReDim gTaskType(gTaskCount - 1)

    Dim i       As Integer
    Dim nm      As String
    Dim stStr   As String
    Dim enStr   As String
    Dim stStr2  As String

    For i = 0 To gTaskCount - 1

        Dim prefix As String
        prefix = "TASK " & (i + 1) & " OF " & gTaskCount & Chr(10) & String(40, "-") & Chr(10) & Chr(10)

        ' Task name
        nm = InputBox( _
            prefix & "Task name:" & Chr(10) & _
            "(e.g. Requirements Analysis, Development Phase 1)", _
            "Gantt Chart Wizard - Task " & (i + 1) & "/" & gTaskCount, _
            "Task " & (i + 1))
        If nm = "" Then Exit Function
        gTaskNames(i) = nm

        ' Start month
        Do
            stStr = InputBox( _
                prefix & "Task: " & nm & Chr(10) & Chr(10) & _
                "Start month (1 to 12):" & Chr(10) & _
                "  1 = January, 2 = February ... 12 = December", _
                "Gantt Chart Wizard - Task " & (i + 1) & "/" & gTaskCount, _
                CStr(i + 1))
            If stStr = "" Then Exit Function
            If IsNumeric(stStr) Then
                If CInt(stStr) >= 1 And CInt(stStr) <= 12 Then Exit Do
            End If
            MsgBox "Please enter a number between 1 and 12.", vbExclamation, "Invalid Input"
        Loop
        gTaskStart(i) = CInt(stStr) - 1   ' convert to 0-based index

        ' End month
        Do
            enStr = InputBox( _
                prefix & "Task: " & nm & Chr(10) & Chr(10) & _
                "End month (1 to 12):" & Chr(10) & _
                "  Must be AFTER the start month (" & stStr & ")" & Chr(10) & _
                "  e.g. starts Jan (1), ends Mar (3) = 3 months long", _
                "Gantt Chart Wizard - Task " & (i + 1) & "/" & gTaskCount, _
                CStr(CInt(stStr) + 2))
            If enStr = "" Then Exit Function
            If IsNumeric(enStr) Then
                If CInt(enStr) >= CInt(stStr) And CInt(enStr) <= 12 Then Exit Do
            End If
            MsgBox "End month must be " & stStr & " or later, and no more than 12.", _
                   vbExclamation, "Invalid Input"
        Loop
        gTaskEnd(i) = CInt(enStr)          ' 1-based inclusive end stored directly

        ' Status
        Dim statusStr As String
        Do
            statusStr = InputBox( _
                prefix & "Task: " & nm & Chr(10) & Chr(10) & _
                "Task status - enter one letter:" & Chr(10) & Chr(10) & _
                "  C  =  Complete  (dark green bar)" & Chr(10) & _
                "  I  =  In Progress  (medium green bar)" & Chr(10) & _
                "  P  =  Planned  (light green bar)", _
                "Gantt Chart Wizard - Task " & (i + 1) & "/" & gTaskCount, "P")
            If statusStr = "" Then Exit Function
            Select Case UCase(Left(Trim(statusStr), 1))
                Case "C": gTaskType(i) = 0: Exit Do
                Case "I": gTaskType(i) = 1: Exit Do
                Case "P": gTaskType(i) = 2: Exit Do
                Case Else
                    MsgBox "Please type C, I, or P.", vbExclamation, "Invalid Input"
            End Select
        Loop

    Next i

    CollectTasks = True

End Function


' ============================================================
' STEP 3 OF 3 - MILESTONES
' ============================================================
Function CollectMilestones() As Boolean

    CollectMilestones = False

    ' How many milestones?
    Dim countStr As String
    Do
        countStr = InputBox( _
            "STEP 3 OF 3 - MILESTONES" & Chr(10) & String(40, "-") & Chr(10) & Chr(10) & _
            "How many milestones? (0 to 5)" & Chr(10) & Chr(10) & _
            "Milestones appear as gold diamonds on the chart." & Chr(10) & _
            "Enter 0 if you don't need any.", _
            "Gantt Chart Wizard - Step 3/3", "3")
        If countStr = "" Then Exit Function
        If IsNumeric(countStr) Then
            If CInt(countStr) >= 0 And CInt(countStr) <= 5 Then Exit Do
        End If
        MsgBox "Please enter a number between 0 and 5.", vbExclamation, "Invalid Input"
    Loop

    gMsCount = CInt(countStr)

    If gMsCount = 0 Then
        CollectMilestones = True
        Exit Function
    End If

    ReDim gMsLabels(gMsCount - 1)
    ReDim gMsMonths(gMsCount - 1)
    ReDim gMsRows(gMsCount - 1)

    Dim ms As Integer
    For ms = 0 To gMsCount - 1

        Dim prefix As String
        prefix = "MILESTONE " & (ms + 1) & " OF " & gMsCount & Chr(10) & String(40, "-") & Chr(10) & Chr(10)

        ' Milestone name
        Dim msName As String
        msName = InputBox( _
            prefix & "Milestone name:" & Chr(10) & _
            "(e.g. Design Sign-off, Go-Live, Phase Complete)", _
            "Gantt Chart Wizard - Milestone " & (ms + 1) & "/" & gMsCount, _
            "Milestone " & (ms + 1))
        If msName = "" Then Exit Function
        gMsLabels(ms) = msName

        ' Month
        Dim msMonStr As String
        Do
            msMonStr = InputBox( _
                prefix & "Milestone: " & msName & Chr(10) & Chr(10) & _
                "Which month should the diamond appear on? (1-12)", _
                "Gantt Chart Wizard - Milestone " & (ms + 1) & "/" & gMsCount, _
                CStr(ms * 3 + 3))
            If msMonStr = "" Then Exit Function
            If IsNumeric(msMonStr) Then
                If CInt(msMonStr) >= 1 And CInt(msMonStr) <= 12 Then Exit Do
            End If
            MsgBox "Please enter a number between 1 and 12.", vbExclamation, "Invalid Input"
        Loop
        gMsMonths(ms) = CInt(msMonStr) - 1   ' convert to 0-based

        ' Task row
        Dim msRowStr As String
        Do
            msRowStr = InputBox( _
                prefix & "Milestone: " & msName & Chr(10) & Chr(10) & _
                "Which task row should the diamond sit on? (1 to " & gTaskCount & ")" & Chr(10) & Chr(10) & _
                "Your tasks:" & Chr(10) & ListTasks(), _
                "Gantt Chart Wizard - Milestone " & (ms + 1) & "/" & gMsCount, _
                CStr(ms + 1))
            If msRowStr = "" Then Exit Function
            If IsNumeric(msRowStr) Then
                If CInt(msRowStr) >= 1 And CInt(msRowStr) <= gTaskCount Then Exit Do
            End If
            MsgBox "Please enter a number between 1 and " & gTaskCount & ".", _
                   vbExclamation, "Invalid Input"
        Loop
        gMsRows(ms) = CInt(msRowStr) - 1     ' convert to 0-based

    Next ms

    CollectMilestones = True

End Function


' Helper: returns numbered task list as a string (for milestone prompt)
Function ListTasks() As String
    Dim s As String
    Dim i As Integer
    s = ""
    For i = 0 To gTaskCount - 1
        s = s & "  " & (i + 1) & ". " & gTaskNames(i) & Chr(10)
    Next i
    ListTasks = s
End Function


' ============================================================
' HELPER: Unlock and name every shape for easy editing
' ============================================================
Sub MakeEditable(shp As Shape, shapeName As String)
    shp.Name = shapeName
    shp.Locked = msoFalse
    shp.LockAspectRatio = msoFalse
End Sub


' ============================================================
' BUILD SLIDE 1 - TITLE SLIDE
' ============================================================
Sub BuildTitleSlide(prs As Presentation)

    Dim sld        As Slide
    Dim bar        As Shape
    Dim bnpBox     As Shape
    Dim titleBox   As Shape
    Dim accentLine As Shape
    Dim subBox     As Shape
    Dim dateBox    As Shape
    Dim circle1    As Shape
    Dim circle2    As Shape
    Dim q1Box      As Shape
    Dim fyBox      As Shape

    Set sld = prs.Slides.Add(1, ppLayoutBlank)
    sld.Background.Fill.ForeColor.RGB = RGB(26, 46, 34)
    sld.Background.Fill.Solid

    Set bar = sld.Shapes.AddShape(msoShapeRectangle, 0, 0, 8, 405)
    bar.Fill.ForeColor.RGB = RGB(0, 150, 94)
    bar.Line.Visible = msoFalse
    Call MakeEditable(bar, "LeftAccentBar")

    Set bnpBox = sld.Shapes.AddShape(msoShapeRectangle, 25, 25, 200, 40)
    bnpBox.Fill.ForeColor.RGB = RGB(0, 150, 94)
    bnpBox.Line.Visible = msoFalse
    With bnpBox.TextFrame
        .TextRange.Text = "BNP PARIBAS"
        .TextRange.Font.Size = 14
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = RGB(255, 255, 255)
        .TextRange.Font.Name = "Arial"
        .WordWrap = msoFalse
        .VerticalAnchor = msoAnchorMiddle
        .TextRange.ParagraphFormat.Alignment = ppAlignCenter
    End With
    Call MakeEditable(bnpBox, "BNP_LogoBox")

    Set titleBox = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 25, 100, 650, 80)
    With titleBox.TextFrame
        .TextRange.Text = gTitle
        .TextRange.Font.Size = 44
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = RGB(255, 255, 255)
        .TextRange.Font.Name = "Georgia"
        .AutoSize = ppAutoSizeNone
    End With
    Call MakeEditable(titleBox, "MainTitle")

    Set accentLine = sld.Shapes.AddShape(msoShapeRectangle, 25, 185, 324, 4)
    accentLine.Fill.ForeColor.RGB = RGB(0, 150, 94)
    accentLine.Line.Visible = msoFalse
    Call MakeEditable(accentLine, "TitleAccentLine")

    Set subBox = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 25, 198, 580, 30)
    With subBox.TextFrame
        .TextRange.Text = gSubtitle
        .TextRange.Font.Size = 14
        .TextRange.Font.Color.RGB = RGB(153, 197, 176)
        .TextRange.Font.Name = "Calibri"
    End With
    Call MakeEditable(subBox, "Subtitle")

    Set dateBox = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 25, 353, 200, 25)
    With dateBox.TextFrame
        .TextRange.Text = Format(Now, "MMMM YYYY")
        .TextRange.Font.Size = 11
        .TextRange.Font.Color.RGB = RGB(102, 143, 126)
        .TextRange.Font.Name = "Calibri"
    End With
    Call MakeEditable(dateBox, "SlideDate")

    Set circle1 = sld.Shapes.AddShape(msoShapeOval, 519, 58, 252, 252)
    circle1.Fill.ForeColor.RGB = RGB(0, 150, 94)
    circle1.Fill.Transparency = 0.88
    circle1.Line.ForeColor.RGB = RGB(0, 150, 94)
    circle1.Line.Transparency = 0.7
    Call MakeEditable(circle1, "DecorCircleOuter")

    Set circle2 = sld.Shapes.AddShape(msoShapeOval, 555, 94, 180, 180)
    circle2.Fill.ForeColor.RGB = RGB(0, 150, 94)
    circle2.Fill.Transparency = 0.75
    circle2.Line.ForeColor.RGB = RGB(0, 150, 94)
    circle2.Line.Transparency = 0.55
    Call MakeEditable(circle2, "DecorCircleInner")

    Set q1Box = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 576, 144, 136, 30)
    With q1Box.TextFrame
        .TextRange.Text = "Q1-Q4"
        .TextRange.Font.Size = 20
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = RGB(255, 255, 255)
        .TextRange.Font.Name = "Georgia"
        .TextRange.ParagraphFormat.Alignment = ppAlignCenter
    End With
    Call MakeEditable(q1Box, "QuarterLabel")

    Set fyBox = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 573, 179, 144, 20)
    With fyBox.TextFrame
        .TextRange.Text = "FY " & gYear
        .TextRange.Font.Size = 12
        .TextRange.Font.Color.RGB = RGB(153, 197, 176)
        .TextRange.Font.Name = "Calibri"
        .TextRange.ParagraphFormat.Alignment = ppAlignCenter
    End With
    Call MakeEditable(fyBox, "FYLabel")

End Sub


' ============================================================
' BUILD SLIDE 2 - GANTT CHART
' ============================================================
Sub BuildGanttSlide(prs As Presentation)

    ' â”€â”€ All Dims at top â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    Dim sld         As Slide
    Dim i           As Integer
    Dim m           As Integer
    Dim q           As Integer
    Dim ms          As Integer

    Dim MON_W       As Single
    Dim totalRowsH  As Single
    Dim ry          As Single
    Dim mx          As Single
    Dim qx          As Single
    Dim barX        As Single
    Dim barW        As Single
    Dim barY        As Single
    Dim barH        As Single
    Dim todayX      As Single
    Dim legendY     As Single
    Dim lx          As Single
    Dim msRow       As Single
