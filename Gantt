    cRed     = RGB(232, 64, 32)
    cTextMid = RGB(74, 99, 88)
    cDone    = RGB(0, 150, 94)
    cActive  = RGB(51, 176, 122)
    cFuture  = RGB(153, 217, 188)

    ' â”€â”€ Month labels â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
