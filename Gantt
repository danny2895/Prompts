' ============================================================
' BNP PARIBAS GANTT CHART - FULLY EDITABLE VBA MACRO
' ============================================================
' HOW TO USE:
'   1. Open PowerPoint
'   2. Press Alt + F11 to open the VBA Editor
'   3. Click Insert > Module
'   4. Paste this entire code into the module
'   5. Press F5 or click Run > Run Sub
'   6. Switch back to PowerPoint - slides are ready to edit!
'
' EDITING TIPS AFTER RUNNING:
'   - Click any shape to move, resize, or recolour it
'   - Double-click any shape to edit its text
'   - View > Selection Pane to see and select shapes by name
'   - Right-click shape > Size and Position for exact values
'   - Hold Shift + click to select multiple shapes at once
' ============================================================

Sub CreateBNPGanttChart()

    Dim prs As Presentation
    Set prs = ActivePresentation

    Do While prs.Slides.Count > 0
        prs.Slides(1).Delete
    Loop

    prs.PageSetup.SlideWidth = 720
    prs.PageSetup.SlideHeight = 405

    Call CreateTitleSlide(prs)
    Call CreateGanttSlide(prs)

    ' Select slide 2 (Gantt) so user lands on it after macro runs
    prs.Slides(2).Select

    MsgBox "Done! Your Gantt chart is ready." & Chr(10) & Chr(10) & _
           "EDITING TIPS:" & Chr(10) & _
           "- Click any shape to move or resize it" & Chr(10) & _
           "- Double-click any shape to edit text" & Chr(10) & _
           "- Use View > Selection Pane to find shapes by name", _
           vbInformation, "BNP Paribas Gantt Chart"

End Sub


' ============================================================
' HELPER: Make any shape fully editable and unlocked
' ============================================================
Sub MakeEditable(shp As Shape, shapeName As String)
    shp.Name = shapeName
    shp.Locked = msoFalse
    shp.LockAspectRatio = msoFalse
End Sub


' ============================================================
' SLIDE 1 - TITLE SLIDE
' ============================================================
Sub CreateTitleSlide(prs As Presentation)

    Dim sld        As Slide
