    ' MILESTONES  (gold rotated diamond)
    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    Dim msTaskRow(2) As Integer
    msTaskRow(0) = 2   ' Design Approved on System Design row
    msTaskRow(1) = 4   ' Dev Complete on Dev Phase 2 row
    msTaskRow(2) = 7   ' Go-Live on Deployment row

    Dim dsz As Single: dsz = 13  ' diamond half-size in pts

    Dim ms As Integer
    For ms = 0 To 2
        Dim msRow  As Single: msRow = ROWS_START + msTaskRow(ms) * (ROW_H + ROW_GAP) + ROW_H / 2
        Dim msX    As Single: msX = CHART_X + msMonths(ms) * MON_W

        ' Gold diamond (rotated square)
        Dim diamond As Shape
        Set diamond = sld.Shapes.AddShape(msoShapeRectangle, msX - dsz / 2, msRow - dsz / 2, dsz, dsz)
        diamond.Fill.ForeColor.RGB = cGold
        diamond.Line.ForeColor.RGB = RGB(192, 112, 16)
        diamond.Line.Weight = 1
        diamond.Rotation = 45

        ' Milestone label below the diamond
        Dim msLbl As Shape
        Set msLbl = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, msX - 36, msRow + 10, 72, 18)
        With msLbl.TextFrame
            .TextRange.Text = msLabels(ms)
            .TextRange.Font.Size = 7
            .TextRange.Font.Bold = True
            .TextRange.Font.Color.RGB = RGB(160, 96, 16)
            .TextRange.Font.Name = "Calibri"
            .TextRange.ParagraphFormat.Alignment = ppAlignCenter
        End With
    Next ms

