    hdr.Line.Visible = msoFalse
    Call MakeEditable(hdr, "Header_Background")

    Set hdrAccent = sld.Shapes.AddShape(msoShapeRectangle, 0, 0, 7, HEADER_H)
    hdrAccent.Fill.ForeColor.RGB = cGreen
    hdrAccent.Line.Visible = msoFalse
    Call MakeEditable(hdrAccent, "Header_GreenAccent")

    Set hdrTxt = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 18, 0, 504, HEADER_H)
    With hdrTxt.TextFrame
        .TextRange.Text = gTitle & " " & gYear
        .TextRange.Font.Size = 18
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = RGB(255, 255, 255)
        .TextRange.Font.Name = "Georgia"
        .VerticalAnchor = msoAnchorMiddle
    End With
    Call MakeEditable(hdrTxt, "Header_Title")

    Set bnpTag = sld.Shapes.AddShape(msoShapeRectangle, 612, 3.6, 90, 28.8)
    bnpTag.Fill.ForeColor.RGB = cGreen
    bnpTag.Line.Visible = msoFalse
    With bnpTag.TextFrame
        .TextRange.Text = "BNP PARIBAS"
        .TextRange.Font.Size = 7
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = RGB(255, 255, 255)
        .TextRange.Font.Name = "Arial"
        .VerticalAnchor = msoAnchorMiddle
        .TextRange.ParagraphFormat.Alignment = ppAlignCenter
    End With
    Call MakeEditable(bnpTag, "Header_BNPTag")

    ' â”€â”€ Month row â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    Set monBg = sld.Shapes.AddShape(msoShapeRectangle, 0, MON_ROW_Y, SW, MON_ROW_H)
    monBg.Fill.ForeColor.RGB = cMonBg
    monBg.Line.Visible = msoFalse
    Call MakeEditable(monBg, "MonthRow_Background")

    Set taskHdr = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 7, MON_ROW_Y, LABEL_W, MON_ROW_H)
    With taskHdr.TextFrame
        .TextRange.Text = "TASK"
        .TextRange.Font.Size = 9
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = cDkGreen
        .TextRange.Font.Name = "Arial"
        .VerticalAnchor = msoAnchorMiddle
    End With
    Call MakeEditable(taskHdr, "MonthRow_TaskLabel")

    For m = 0 To 11
        mx = CHART_X + m * MON_W
        If m Mod 2 = 0 Then
            Set monShade = sld.Shapes.AddShape(msoShapeRectangle, mx, MON_ROW_Y, MON_W, MON_ROW_H)
            monShade.Fill.ForeColor.RGB = cMonAlt
            monShade.Line.Visible = msoFalse
            Call MakeEditable(monShade, "MonthShade_" & months(m))
        End If
        Set monTxt = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, mx, MON_ROW_Y, MON_W, MON_ROW_H)
        With monTxt.TextFrame
            .TextRange.Text = months(m)
            .TextRange.Font.Size = 9
            .TextRange.Font.Bold = True
            .TextRange.Font.Color.RGB = cDkGreen
            .TextRange.Font.Name = "Arial"
            .VerticalAnchor = msoAnchorMiddle
            .TextRange.ParagraphFormat.Alignment = ppAlignCenter
        End With
        Call MakeEditable(monTxt, "MonthLabel_" & months(m))
    Next m

    ' â”€â”€ Quarter dividers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    For q = 1 To 3
        qx = CHART_X + q * 3 * MON_W
        Set qLine = sld.Shapes.AddLine(qx, MON_ROW_Y, qx, ROWS_START + totalRowsH)
        qLine.Line.ForeColor.RGB = cGreen
        qLine.Line.Weight = 0.75
        qLine.Line.DashStyle = msoLineDash
        Call MakeEditable(qLine, "QuarterDivider_Q" & q)
    Next q

    ' â”€â”€ Task rows + Gantt bars â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    For i = 0 To gTaskCount - 1
        ry = ROWS_START + i * (ROW_H + ROW_GAP)

        If i Mod 2 = 1 Then
            Set rowBg = sld.Shapes.AddShape(msoShapeRectangle, 0, ry, SW, ROW_H)
            rowBg.Fill.ForeColor.RGB = cRowAlt
            rowBg.Line.Visible = msoFalse
            Call MakeEditable(rowBg, "RowBg_" & i)
        End If

        Set lblBox = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 14, ry, LABEL_W - 14, ROW_H)
        With lblBox.TextFrame
            .TextRange.Text = gTaskNames(i)
            .TextRange.Font.Size = 9
            .TextRange.Font.Color.RGB = cDeepBg
            .TextRange.Font.Name = "Calibri"
            .VerticalAnchor = msoAnchorMiddle
            .AutoSize = ppAutoSizeNone
        End With
        Call MakeEditable(lblBox, "TaskLabel_" & (i + 1))

        Set divLine = sld.Shapes.AddLine(LABEL_W, ry, LABEL_W, ry + ROW_H)
        divLine.Line.ForeColor.RGB = cDivider
        divLine.Line.Weight = 0.75
        Call MakeEditable(divLine, "RowDivider_" & (i + 1))

        barX = CHART_X + gTaskStart(i) * MON_W + BAR_PAD
        barW = (gTaskEnd(i) - gTaskStart(i)) * MON_W - BAR_PAD * 2
        barY = ry + ROW_H * 0.22
        barH = ROW_H * 0.56

        Set ganttBar = sld.Shapes.AddShape(msoShapeRoundedRectangle, barX, barY, barW, barH)
        ganttBar.Adjustments(1) = 0.15
        ganttBar.Line.Visible = msoFalse

        Select Case gTaskType(i)
            Case 0: ganttBar.Fill.ForeColor.RGB = cDone
            Case 1: ganttBar.Fill.ForeColor.RGB = cActive
            Case 2: ganttBar.Fill.ForeColor.RGB = cFuture
        End Select

        Select Case gTaskType(i)
            Case 0: barLabel = Chr(10003) & " Complete"
            Case 1: barLabel = "In Progress"
            Case 2: barLabel = "Planned"
        End Select

        With ganttBar.TextFrame
            .TextRange.Text = barLabel
            .TextRange.Font.Size = 7.5
            .TextRange.Font.Bold = True
            .TextRange.Font.Color.RGB = RGB(255, 255, 255)
            .TextRange.Font.Name = "Calibri"
            .VerticalAnchor = msoAnchorMiddle
            .TextRange.ParagraphFormat.Alignment = ppAlignCenter
        End With
        Call MakeEditable(ganttBar, "GanttBar_" & (i + 1) & "_" & gTaskNames(i))

    Next i

    ' â”€â”€ Today line â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    todayX = CHART_X + gTodayMonth * MON_W
    Set todayLine = sld.Shapes.AddLine(todayX, MON_ROW_Y, todayX, ROWS_START + totalRowsH)
    todayLine.Line.ForeColor.RGB = cRed
    todayLine.Line.Weight = 1.5
    todayLine.Line.DashStyle = msoLineSysDot
    Call MakeEditable(todayLine, "TodayLine")

    Set todayTag = sld.Shapes.AddShape(msoShapeRectangle, todayX - 20, MON_ROW_Y + 0.7, 40, 14.4)
    todayTag.Fill.ForeColor.RGB = cRed
    todayTag.Line.Visible = msoFalse
    With todayTag.TextFrame
        .TextRange.Text = "TODAY"
        .TextRange.Font.Size = 6
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = RGB(255, 255, 255)
        .TextRange.Font.Name = "Arial"
        .VerticalAnchor = msoAnchorMiddle
        .TextRange.ParagraphFormat.Alignment = ppAlignCenter
    End With
    Call MakeEditable(todayTag, "TodayTag")

    ' â”€â”€ Milestones â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    For ms = 0 To gMsCount - 1
        msRow = ROWS_START + gMsRows(ms) * (ROW_H + ROW_GAP) + ROW_H / 2
        msX = CHART_X + gMsMonths(ms) * MON_W

        Set diamond = sld.Shapes.AddShape(msoShapeRectangle, msX - dsz / 2, msRow - dsz / 2, dsz, dsz)
        diamond.Fill.ForeColor.RGB = cGold
        diamond.Line.ForeColor.RGB = RGB(192, 112, 16)
        diamond.Line.Weight = 1
        diamond.Rotation = 45
        Call MakeEditable(diamond, "Milestone_Diamond_" & (ms + 1))

        Set msLbl = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, msX - 36, msRow + 10, 72, 18)
        With msLbl.TextFrame
            .TextRange.Text = gMsLabels(ms)
            .TextRange.Font.Size = 7
            .TextRange.Font.Bold = True
            .TextRange.Font.Color.RGB = RGB(160, 96, 16)
            .TextRange.Font.Name = "Calibri"
            .TextRange.ParagraphFormat.Alignment = ppAlignCenter
        End With
        Call MakeEditable(msLbl, "Milestone_Label_" & (ms + 1))
    Next ms

    ' â”€â”€ Legend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    legendY = ROWS_START + totalRowsH + 4
    lx = 21.6

    Set leg1 = sld.Shapes.AddShape(msoShapeRoundedRectangle, lx, legendY + 2, 18, 12)
    leg1.Fill.ForeColor.RGB = cDone
    leg1.Line.Visible = msoFalse
    Call MakeEditable(leg1, "Legend_CompleteBox")
    Call AddLegendLabel(sld, lx + 22, legendY, "Complete", cTextMid, "Legend_CompleteText")

    lx = lx + 93.6
    Set leg2 = sld.Shapes.AddShape(msoShapeRoundedRectangle, lx, legendY + 2, 18, 12)
    leg2.Fill.ForeColor.RGB = cActive
    leg2.Line.Visible = msoFalse
    Call MakeEditable(leg2, "Legend_ActiveBox")
    Call AddLegendLabel(sld, lx + 22, legendY, "In Progress", cTextMid, "Legend_ActiveText")

    lx = lx + 93.6
    Set leg3 = sld.Shapes.AddShape(msoShapeRoundedRectangle, lx, legendY + 2, 18, 12)
    leg3.Fill.ForeColor.RGB = cFuture
    leg3.Line.Visible = msoFalse
    Call MakeEditable(leg3, "Legend_PlannedBox")
    Call AddLegendLabel(sld, lx + 22, legendY, "Planned", cTextMid, "Legend_PlannedText")

    lx = lx + 93.6
    Set legDia = sld.Shapes.AddShape(msoShapeRectangle, lx + 3, legendY + 2, 10, 10)
    legDia.Fill.ForeColor.RGB = cGold
    legDia.Line.Visible = msoFalse
    legDia.Rotation = 45
    Call MakeEditable(legDia, "Legend_MilestoneDiamond")
    Call AddLegendLabel(sld, lx + 22, legendY, "Milestone", cTextMid, "Legend_MilestoneText")

    lx = lx + 93.6
    Set legLine = sld.Shapes.AddLine(lx, legendY + 8, lx + 18, legendY + 8)
    legLine.Line.ForeColor.RGB = cRed
    legLine.Line.Weight = 1.5
    legLine.Line.DashStyle = msoLineSysDot
    Call MakeEditable(legLine, "Legend_TodayLine")
    Call AddLegendLabel(sld, lx + 22, legendY, "Today", cTextMid, "Legend_TodayText")

    ' â”€â”€ Footer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    Set footer = sld.Shapes.AddShape(msoShapeRectangle, 0, SH - 16, SW, 16)
    footer.Fill.ForeColor.RGB = cDeepBg
    footer.Line.Visible = msoFalse
    Call MakeEditable(footer, "Footer_Background")

    Set ftLeft = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 18, SH - 16, 500, 16)
    With ftLeft.TextFrame
        .TextRange.Text = "BNP PARIBAS  |  " & gDept & "  |  Confidential"
        .TextRange.Font.Size = 6.5
        .TextRange.Font.Color.RGB = RGB(102, 143, 126)
        .TextRange.Font.Name = "Calibri"
        .VerticalAnchor = msoAnchorMiddle
    End With
    Call MakeEditable(ftLeft, "Footer_LeftText")

    Set ftRight = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 633.6, SH - 16, 72, 16)
    With ftRight.TextFrame
        .TextRange.Text = gYear
        .TextRange.Font.Size = 6.5
        .TextRange.Font.Color.RGB = RGB(102, 143, 126)
        .TextRange.Font.Name = "Calibri"
        .VerticalAnchor = msoAnchorMiddle
        .TextRange.ParagraphFormat.Alignment = ppAlignRight
    End With
    Call MakeEditable(ftRight, "Footer_RightText")

End Sub


' ============================================================
' HELPER: Add a legend label
' ============================================================
Sub AddLegendLabel(sld As Slide, x As Single, y As Single, _
                   txt As String, col As Long, shapeName As String)
    Dim lbl As Shape
    Set lbl = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, x, y, 65, 18)
    With lbl.TextFrame
        .TextRange.Text = txt
        .TextRange.Font.Size = 8
        .TextRange.Font.Color.RGB = col
        .TextRange.Font.Name = "Calibri"
        .VerticalAnchor = msoAnchorMiddle
    End With
    Call MakeEditable(lbl, shapeName)
End Sub
