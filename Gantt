    Dim cRowAlt     As Long
    Dim cMonAlt     As Long
    Dim cMonBg      As Long
    Dim cDivider    As Long
    Dim cGold       As Long
    Dim cRed        As Long
    Dim cTextMid    As Long
    Dim cDone       As Long
    Dim cActive     As Long
    Dim cFuture     As Long

    Dim hdr         As Shape
    Dim hdrAccent   As Shape
    Dim hdrTxt      As Shape
    Dim bnpTag      As Shape
    Dim monBg       As Shape
    Dim taskHdr     As Shape
    Dim monShade    As Shape
    Dim monTxt      As Shape
    Dim qLine       As Shape
    Dim rowBg       As Shape
    Dim lblBox      As Shape
    Dim divLine     As Shape
    Dim ganttBar    As Shape
    Dim todayLine   As Shape
    Dim todayTag    As Shape
    Dim diamond     As Shape
    Dim msLbl       As Shape
    Dim leg1        As Shape
    Dim leg2        As Shape
    Dim leg3        As Shape
    Dim legDia      As Shape
    Dim legLine     As Shape
    Dim footer      As Shape
    Dim ftLeft      As Shape
    Dim ftRight     As Shape

    Dim months(11)  As String
    Dim barLabel    As String

    ' â”€â”€ Layout â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    Const SW         As Single = 720
    Const SH         As Single = 405
    Const LABEL_W    As Single = 165.6
    Const CHART_X    As Single = 169.2
    Const CHART_W    As Single = 532.8
    Const MONTHS_CNT As Integer = 12
    Const HEADER_H   As Single = 39.6
    Const MON_ROW_Y  As Single = 39.6
    Const MON_ROW_H  As Single = 21.6
    Const ROWS_START As Single = 61.2
    Const BAR_PAD    As Single = 2.88

    ' Row height is dynamic based on task count so everything fits
    Dim ROW_H   As Single
    Dim ROW_GAP As Single
    Dim availH  As Single

    availH = SH - ROWS_START - 35   ' leave room for legend and footer
    ROW_H   = (availH / gTaskCount) * 0.88
    ROW_GAP = (availH / gTaskCount) * 0.12
    If ROW_H > 30 Then ROW_H = 30
    If ROW_GAP > 4 Then ROW_GAP = 4

    MON_W = CHART_W / MONTHS_CNT
    dsz = 13
    totalRowsH = gTaskCount * (ROW_H + ROW_GAP)

    ' â”€â”€ Colours â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
