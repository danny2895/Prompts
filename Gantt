    Const ROW_GAP    As Single = 2.88
    Const BAR_PAD    As Single = 2.88

    MON_W = CHART_W / MONTHS_CNT
    dsz = 13

    ' â”€â”€ Colours â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    cDeepBg  = RGB(26, 46, 34)
    cGreen   = RGB(0, 150, 94)
    cDkGreen = RGB(0, 107, 67)
    cRowAlt  = RGB(234, 246, 240)
    cMonAlt  = RGB(208, 237, 226)
    cMonBg   = RGB(232, 245, 239)
    cDivider = RGB(200, 222, 214)
    cGold    = RGB(232, 160, 32)
    cRed     = RGB(232, 64, 32)
    cTextMid = RGB(74, 99, 88)
    cDone    = RGB(0, 150, 94)
    cActive  = RGB(51, 176, 122)
    cFuture  = RGB(153, 217, 188)

    ' â”€â”€ Month names â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    months(0) = "Jan": months(1)  = "Feb": months(2)  = "Mar"
    months(3) = "Apr": months(4)  = "May": months(5)  = "Jun"
    months(6) = "Jul": months(7)  = "Aug": months(8)  = "Sep"
    months(9) = "Oct": months(10) = "Nov": months(11) = "Dec"

    ' â”€â”€ Task data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    ' To change tasks: edit the name, start month (0=Jan),
    ' end month (exclusive), and type (0=done,1=active,2=future)
    taskNames(0) = "Project Initiation":       taskStart(0) = 0:  taskEnd(0) = 2:  taskType(0) = 0
    taskNames(1) = "Requirements Analysis":    taskStart(1) = 1:  taskEnd(1) = 3:  taskType(1) = 0
    taskNames(2) = "System Design":            taskStart(2) = 2:  taskEnd(2) = 4:  taskType(2) = 0
    taskNames(3) = "Development - Phase 1":    taskStart(3) = 3:  taskEnd(3) = 6:  taskType(3) = 1
    taskNames(4) = "Development - Phase 2":    taskStart(4) = 5:  taskEnd(4) = 8:  taskType(4) = 1
    taskNames(5) = "Testing & QA":             taskStart(5) = 7:  taskEnd(5) = 9:  taskType(5) = 2
    taskNames(6) = "User Acceptance Testing":  taskStart(6) = 8:  taskEnd(6) = 10: taskType(6) = 2
    taskNames(7) = "Deployment & Go-Live":     taskStart(7) = 9:  taskEnd(7) = 11: taskType(7) = 2
    taskNames(8) = "Post-Launch Support":      taskStart(8) = 10: taskEnd(8) = 12: taskType(8) = 2

    ' â”€â”€ Milestone data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    msLabels(0) = "Design Approved": msMonths(0) = 4:  msTaskRow(0) = 2
    msLabels(1) = "Dev Complete":    msMonths(1) = 8:  msTaskRow(1) = 4
    msLabels(2) = "Go-Live":         msMonths(2) = 10: msTaskRow(2) = 7

    totalRowsH = 9 * (ROW_H + ROW_GAP)

    ' â”€â”€ Create slide â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    Set sld = prs.Slides.Add(2, ppLayoutBlank)
    sld.Background.Fill.ForeColor.RGB = RGB(255, 255, 255)
    sld.Background.Fill.Solid

    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    ' HEADER
    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    Set hdr = sld.Shapes.AddShape(msoShapeRectangle, 0, 0, SW, HEADER_H)
    hdr.Fill.ForeColor.RGB = cDeepBg
    hdr.Line.Visible = msoFalse
    Call MakeEditable(hdr, "Header_Background")

    Set hdrAccent = sld.Shapes.AddShape(msoShapeRectangle, 0, 0, 7, HEADER_H)
    hdrAccent.Fill.ForeColor.RGB = cGreen
    hdrAccent.Line.Visible = msoFalse
    Call MakeEditable(hdrAccent, "Header_GreenAccent")

    Set hdrTxt = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 18, 0, 504, HEADER_H)
    With hdrTxt.TextFrame
        .TextRange.Text = "Project Roadmap 2026"
        .TextRange.Font.Size = 18
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = RGB(255, 255, 255)
        .TextRange.Font.Name = "Georgia"
        .VerticalAnchor = msoAnchorMiddle
    End With
    Call MakeEditable(hdrTxt, "Header_Title")

    Set bnpTag = sld.Shapes.AddShape(msoShapeRectangle, 612, 3.6, 90, 28.8)
    bnpTag.Fill.ForeColor.RGB = cGreen
    bnpTag.Line.Visible = msoFalse
    With bnpTag.TextFrame
        .TextRange.Text = "BNP PARIBAS"
        .TextRange.Font.Size = 7
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = RGB(255, 255, 255)
        .TextRange.Font.Name = "Arial"
        .VerticalAnchor = msoAnchorMiddle
        .TextRange.ParagraphFormat.Alignment = ppAlignCenter
    End With
    Call MakeEditable(bnpTag, "Header_BNPTag")

    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    ' MONTH ROW
    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    Set monBg = sld.Shapes.AddShape(msoShapeRectangle, 0, MON_ROW_Y, SW, MON_ROW_H)
    monBg.Fill.ForeColor.RGB = cMonBg
    monBg.Line.Visible = msoFalse
    Call MakeEditable(monBg, "MonthRow_Background")

    Set taskHdr = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 7, MON_ROW_Y, LABEL_W, MON_ROW_H)
    With taskHdr.TextFrame
        .TextRange.Text = "TASK"
        .TextRange.Font.Size = 9
        .TextRange.Font.Bold = True
        .TextRange.Font.Color.RGB = cDkGreen
        .TextRange.Font.Name = "Arial"
        .VerticalAnchor = msoAnchorMiddle
    End With
    Call MakeEditable(taskHdr, "MonthRow_TaskLabel")

    For m = 0 To 11
        mx = CHART_X + m * MON_W
        If m Mod 2 = 0 Then
            Set monShade = sld.Shapes.AddShape(msoShapeRectangle, mx, MON_ROW_Y, MON_W, MON_ROW_H)
            monShade.Fill.ForeColor.RGB = cMonAlt
            monShade.Line.Visible = msoFalse
            Call MakeEditable(monShade, "MonthShade_" & months(m))
        End If
        Set monTxt = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, mx, MON_ROW_Y, MON_W, MON_ROW_H)
        With monTxt.TextFrame
            .TextRange.Text = months(m)
            .TextRange.Font.Size = 9
            .TextRange.Font.Bold = True
            .TextRange.Font.Color.RGB = cDkGreen
            .TextRange.Font.Name = "Arial"
            .VerticalAnchor = msoAnchorMiddle
            .TextRange.ParagraphFormat.Alignment = ppAlignCenter
        End With
        Call MakeEditable(monTxt, "MonthLabel_" & months(m))
    Next m

    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    ' QUARTER DIVIDERS
    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    For q = 1 To 3
        qx = CHART_X + q * 3 * MON_W
        Set qLine = sld.Shapes.AddLine(qx, MON_ROW_Y, qx, ROWS_START + totalRowsH)
        qLine.Line.ForeColor.RGB = cGreen
        qLine.Line.Weight = 0.75
        qLine.Line.DashStyle = msoLineDash
        Call MakeEditable(qLine, "QuarterDivider_Q" & q)
    Next q

    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    ' TASK ROWS + GANTT BARS
    ' â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    For i = 0 To 8
        ry = ROWS_START + i * (ROW_H + ROW_GAP)

        ' Alternating row background
        If i Mod 2 = 1 Then
            Set rowBg = sld.Shapes.AddShape(msoShapeRectangle, 0, ry, SW, ROW_H)
            rowBg.Fill.ForeColor.RGB = cRowAlt
            rowBg.Line.Visible = msoFalse
            Call MakeEditable(rowBg, "RowBg_" & i)
        End If

        ' Task label â€” double-click to rename
        Set lblBox = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, 14, ry, LABEL_W - 14, ROW_H)
        With lblBox.TextFrame
            .TextRange.Text = taskNames(i)
            .TextRange.Font.Size = 9
            .TextRange.Font.Color.RGB = cDeepBg
            .TextRange.Font.Name = "Calibri"
            .VerticalAnchor = msoAnchorMiddle
            .AutoSize = ppAutoSizeNone
        End With
        Call MakeEditable(lblBox, "TaskLabel_" & i & "_" & taskNames(i))

        ' Column divider
        Set divLine = sld.Shapes.AddLine(LABEL_W, ry, LABEL_W, ry + ROW_H)
        divLine.Line.ForeColor.RGB = cDivider
        divLine.Line.Weight = 0.75
        Call MakeEditable(divLine, "RowDivider_" & i)

        ' Gantt bar â€” drag edges to change duration, drag body to shift dates
        barX = CHART_X + taskStart(i) * MON_W + BAR_PAD
        barW = (taskEnd(i) - taskStart(i)) * MON_W - BAR_PAD * 2
        barY = ry + ROW_H * 0.22
        barH = ROW_H * 0.56

        Set ganttBar = sld.Shapes.AddShape(msoShapeRoundedRectangle, barX, barY, barW, barH)
        ganttBar.Adjustments(1) = 0.15
        ganttBar.Line.Visible = msoFalse

        Select Case taskType(i)
            Case 0: ganttBar.Fill.ForeColor.RGB = cDone
            Case 1: ganttBar.Fill.ForeColor.RGB = cActive
            Case 2: ganttBar.Fill.ForeColor.RGB = cFuture
        End Select

        Select Case taskType(i)
            Case 0: barLabel = Chr(10003) & " Complete"
            Case 1: barLabel = "In Progress"
            Case 2: barLabel = "Planned"
        End Select

        With ganttBar.TextFrame
            .TextRange.Text = barLabel
            .TextRange.Font.Size = 7.5
            .TextRange.Font.Bold = True
            .TextRange.Font.Color.RGB = RGB(255, 255, 255)
