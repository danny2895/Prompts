    Dim cDkGreen    As Long
    Dim cRowAlt     As Long
    Dim cMonAlt     As Long
    Dim cMonBg      As Long
    Dim cDivider    As Long
    Dim cGold       As Long
    Dim cRed        As Long
    Dim cTextMid    As Long
    Dim cDone       As Long
    Dim cActive     As Long
    Dim cFuture     As Long

    Dim hdr         As Shape
    Dim hdrAccent   As Shape
    Dim hdrTxt      As Shape
    Dim bnpTag      As Shape
    Dim monBg       As Shape
    Dim taskHdr     As Shape
    Dim monShade    As Shape
    Dim monTxt      As Shape
    Dim qLine       As Shape
    Dim rowBg       As Shape
    Dim lblBox      As Shape
    Dim divLine     As Shape
    Dim ganttBar    As Shape
    Dim todayLine   As Shape
    Dim todayTag    As Shape
    Dim diamond     As Shape
    Dim msLbl       As Shape
    Dim leg1        As Shape
    Dim leg2        As Shape
    Dim leg3        As Shape
    Dim legDia      As Shape
    Dim legLine     As Shape
    Dim footer      As Shape
    Dim ftLeft      As Shape
    Dim ftRight     As Shape

    Dim taskNames(8)  As String
    Dim taskStart(8)  As Integer
    Dim taskEnd(8)    As Integer
    Dim taskType(8)   As Integer
    Dim months(11)    As String
    Dim msLabels(2)   As String
