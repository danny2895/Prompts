' ============================================================
Sub CreateGanttSlide(prs As Presentation)

    ' â”€â”€ All Dims at top (VBA requirement) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    Dim sld         As Slide
    Dim i           As Integer
    Dim m           As Integer
    Dim q           As Integer
    Dim ms          As Integer

    Dim MON_W       As Single
    Dim totalRowsH  As Single
    Dim ry          As Single
    Dim mx          As Single
    Dim qx          As Single
    Dim barX        As Single
    Dim barW        As Single
    Dim barY        As Single
    Dim barH        As Single
    Dim todayX      As Single
    Dim legendY     As Single
    Dim lx          As Single
    Dim msRow       As Single
